{
  "manifest_version": 3,
  "name": "Nexo · Consulta clínica",
  "version": "3.6.0",
  "minimum_chrome_version": "116",
  "description": "Solicitudes clínicas, seguimiento del Mini y biblioteca de resúmenes verificados junto a Eloísa.",
  "permissions": [
    "cookies",
    "scripting",
    "tabs",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://exalab.saludoriente.cl/*",
    "https://clinicohangaroa.eloisa.cl/*",
    "https://fichamedico.rayensalud.cl/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches":["https://clinicohangaroa.eloisa.cl/*"],
      "js":["eloisa_panel.js"],
      "run_at":"document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {"default_path":"panel/index.html"},
  "action": {
    "default_title": "Abrir Nexo",
    "default_icon": {
      "16": "icons/nexo-16.png",
      "32": "icons/nexo-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://clinicohangaroa.eloisa.cl https://fichamedico.rayensalud.cl http://127.0.0.1:8765; frame-src 'self'; base-uri 'none'; frame-ancestors 'self'"
  },
  "short_name": "Nexo",
  "icons": {
    "16": "icons/nexo-16.png",
    "32": "icons/nexo-32.png",
    "48": "icons/nexo-48.png",
    "128": "icons/nexo-128.png"
  }
}
